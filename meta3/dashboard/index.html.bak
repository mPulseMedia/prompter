<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Test Dashboard - Meta3</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            margin: 0;
            padding: 20px;
            background-color: #0d1117;
            color: #c9d1d9;
        }
        
        .container {
            max-width: 1200px;
            margin: 0 auto;
        }
        
        h1 {
            color: #c9d1d9;
            margin-bottom: 30px;
        }
        
        .test-list {
            background: #161b22;
            border-radius: 8px;
            border: 1px solid #30363d;
            padding: 20px;
        }
        
        .test-item {
            display: flex;
            align-items: center;
            padding: 12px;
            border-bottom: 1px solid #30363d;
            font-size: 16px;
        }
        
        .test-item:last-child {
            border-bottom: none;
        }
        
        .test-status {
            font-size: 16px;
            margin-left: 10px;
        }
        
        .test-name {
            font-weight: 500;
            color: #c9d1d9;
        }
        
        .test-error {
            color: #f85149;
            font-size: 14px;
            margin-left: 35px;
            margin-top: 5px;
        }
        
        .summary {
            display: flex;
            gap: 20px;
            margin-bottom: 20px;
        }
        
        .summary-item {
            background: #161b22;
            padding: 15px 20px;
            border-radius: 8px;
            border: 1px solid #30363d;
        }
        
        .summary-label {
            color: #8b949e;
            font-size: 14px;
        }
        
        .summary-value {
            font-size: 24px;
            font-weight: bold;
            margin-top: 5px;
            color: #c9d1d9;
        }
        
        .summary-value.passed {
            color: #3fb950;
        }
        
        .summary-value.failed {
            color: #f85149;
        }
        
        .refresh-btn {
            background: #238636;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 5px;
            cursor: pointer;
            font-size: 16px;
            margin-bottom: 20px;
        }
        
        .refresh-btn:hover {
            background: #2ea043;
        }
        
        .loading {
            text-align: center;
            color: #8b949e;
            padding: 40px;
        }
        
        .error-message {
            background: #21262d;
            color: #f85149;
            padding: 15px;
            border-radius: 5px;
            border: 1px solid #30363d;
            margin-bottom: 20px;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Meta3 Test Dashboard</h1>
        
        <button class="refresh-btn" onclick="loadTests()">Refresh Tests</button>
        
        <div class="summary" id="summary" style="display: none;">
            <div class="summary-item">
                <div class="summary-label">Total Tests</div>
                <div class="summary-value" id="total-tests">0</div>
            </div>
            <div class="summary-item">
                <div class="summary-label">Passed</div>
                <div class="summary-value passed" id="passed-tests">0</div>
            </div>
            <div class="summary-item">
                <div class="summary-label">Failed</div>
                <div class="summary-value failed" id="failed-tests">0</div>
            </div>
        </div>
        
        <div class="test-list" id="test-list">
            <div class="loading">Loading tests...</div>
        </div>
    </div>
    
    <script>
        async function loadTests() {
            const testList = document.getElementById('test-list');
            const summary = document.getElementById('summary');
            
            testList.innerHTML = '<div class="loading">Loading tests...</div>';
            summary.style.display = 'none';
            
            try {
                const response = await fetch('/api/test');
                const tests = await response.json();
                
                if (!tests || tests.length === 0) {
                    testList.innerHTML = '<div class="error-message">No test results found. Run tests first.</div>';
                    return;
                }
                
                // Sort tests by name
                tests.sort((a, b) => a.name.localeCompare(b.name));
                
                // Update summary
                const totalTests = tests.length;
                const passedTests = tests.filter(t => t.passed).length;
                const failedTests = totalTests - passedTests;
                
                document.getElementById('total-tests').textContent = totalTests;
                document.getElementById('passed-tests').textContent = passedTests;
                document.getElementById('failed-tests').textContent = failedTests;
                summary.style.display = 'flex';
                
                // Display tests
                testList.innerHTML = tests.map(test => {
                    const status = test.passed ? '🟢' : '🔴';
                    let html = `
                        <div class="test-item">
                            <span class="test-name">${test.name}_test</span>
                            <span class="test-status">${status}</span>
                        </div>
                    `;
                    
                    if (!test.passed && test.error) {
                        html += `<div class="test-error">${test.error}</div>`;
                    }
                    
                    return html;
                }).join('');
                
            } catch (error) {
                testList.innerHTML = `<div class="error-message">Error loading tests: ${error.message}</div>`;
            }
        }
        
        // Load tests on page load
        loadTests();
        
        // Auto-refresh every 5 seconds
        setInterval(loadTests, 5000);
    </script>
</body>
</html>